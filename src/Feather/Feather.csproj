<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>FeatherCompute</PackageId>
    <Title>FeatherCompute</Title>
    <Description>C# frontend API for EasyGPU compute, graphics, automatic differentiation, and neural network workloads.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Feather.ManifestExporter\Feather.ManifestExporter.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\Feather.Native\Feather.Native.csproj" />
    <ProjectReference Include="..\Feather.NativeAssets\Feather.NativeAssets.csproj" />
  </ItemGroup>

  <!-- Shared shader helpers reach consumers as injected source (see FeatherCompute.targets), so they
       must not also be compiled into this assembly: a consuming project would then see the same
       types twice. Packed as content beside buildTransitive instead. Feather.Integration.Tests
       includes the directory explicitly, which is what type-checks it in CI. -->
  <ItemGroup>
    <Compile Remove="Shaders\**\*.cs" />
    <None Include="Shaders\**\*.cs"
          Pack="true"
          PackagePath="build\shaders"
          Visible="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\FeatherCompute.targets"
          Pack="true"
          PackagePath="buildTransitive\FeatherCompute.targets"
          Visible="false" />
    <None Include="..\Feather.ManifestExporter\bin\$(Configuration)\net10.0\Feather.ManifestExporter.dll"
          Pack="true"
          PackagePath="tools\net10.0"
          Visible="false" />
    <None Include="..\Feather.ManifestExporter\bin\$(Configuration)\net10.0\Feather.ManifestExporter.deps.json"
          Pack="true"
          PackagePath="tools\net10.0"
          Visible="false" />
    <None Include="..\Feather.ManifestExporter\bin\$(Configuration)\net10.0\Feather.ManifestExporter.runtimeconfig.json"
          Pack="true"
          PackagePath="tools\net10.0"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Feather.Generators\Feather.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)\..\Feather.Generators\bin\$(Configuration)\netstandard2.0\Feather.Generators.dll"
             Pack="true"
             PackagePath="analyzers/dotnet/cs"
             Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Feather.AD.Tests" />
    <InternalsVisibleTo Include="Feather.NN.Tests" />
    <InternalsVisibleTo Include="Feather.Integration.Tests" />
  </ItemGroup>

</Project>

<Project>
  <PropertyGroup>
    <FeatherEmitPassManifest Condition="'$(FeatherEmitPassManifest)' == ''">true</FeatherEmitPassManifest>
    <FeatherPassManifestPath Condition="'$(FeatherPassManifestPath)' == ''">$(MSBuildProjectDirectory)/Generated/pass-manifest.json</FeatherPassManifestPath>
    <FeatherEmitAssetManifest Condition="'$(FeatherEmitAssetManifest)' == ''">true</FeatherEmitAssetManifest>
    <FeatherAssetManifestPath Condition="'$(FeatherAssetManifestPath)' == ''">$(MSBuildProjectDirectory)/Generated/asset-manifest.json</FeatherAssetManifestPath>
    <FeatherFeirDirectory Condition="'$(FeatherFeirDirectory)' == ''">Generated/feather-ir</FeatherFeirDirectory>
    <FeatherManifestExporterPath Condition="'$(FeatherManifestExporterPath)' == '' and Exists('$(MSBuildThisFileDirectory)../../Feather.ManifestExporter/Feather.ManifestExporter.csproj')">$(MSBuildThisFileDirectory)../../Feather.ManifestExporter/bin/$(Configuration)/net10.0/Feather.ManifestExporter.dll</FeatherManifestExporterPath>
    <FeatherManifestExporterPath Condition="'$(FeatherManifestExporterPath)' == ''">$(MSBuildThisFileDirectory)../tools/net10.0/Feather.ManifestExporter.dll</FeatherManifestExporterPath>
    <FeatherDotNetHostPath Condition="'$(FeatherDotNetHostPath)' == '' and '$(DotNetHostPath)' != ''">$(DotNetHostPath)</FeatherDotNetHostPath>
    <FeatherDotNetHostPath Condition="'$(FeatherDotNetHostPath)' == ''">dotnet</FeatherDotNetHostPath>
    <FeatherPassManifestArgument Condition="'$(FeatherEmitPassManifest)' == 'true'">--output &quot;$(FeatherPassManifestPath)&quot;</FeatherPassManifestArgument>
    <FeatherAssetManifestArgument Condition="'$(FeatherEmitAssetManifest)' == 'true'">--asset-output &quot;$(FeatherAssetManifestPath)&quot;</FeatherAssetManifestArgument>
    <FeatherManifestOutputs Condition="'$(FeatherEmitPassManifest)' == 'true'">$(FeatherPassManifestPath)</FeatherManifestOutputs>
    <FeatherManifestOutputs Condition="'$(FeatherEmitAssetManifest)' == 'true' and '$(FeatherManifestOutputs)' != ''">$(FeatherManifestOutputs);$(FeatherAssetManifestPath)</FeatherManifestOutputs>
    <FeatherManifestOutputs Condition="'$(FeatherEmitAssetManifest)' == 'true' and '$(FeatherManifestOutputs)' == ''">$(FeatherAssetManifestPath)</FeatherManifestOutputs>
  </PropertyGroup>

  <PropertyGroup>
    <FeatherInjectShaderLibrary Condition="'$(FeatherInjectShaderLibrary)' == ''">true</FeatherInjectShaderLibrary>
    <FeatherShaderLibraryDirectory Condition="'$(FeatherShaderLibraryDirectory)' == '' and Exists('$(MSBuildThisFileDirectory)../Shaders')">$(MSBuildThisFileDirectory)../Shaders</FeatherShaderLibraryDirectory>
    <FeatherShaderLibraryDirectory Condition="'$(FeatherShaderLibraryDirectory)' == ''">$(MSBuildThisFileDirectory)shaders</FeatherShaderLibraryDirectory>
  </PropertyGroup>

  <!-- The shared shader library has to arrive as source, not as a reference. The generator lowers
       [Callable] bodies from syntax, so a callable that only exists in a compiled assembly is
       rejected with FE0008 ("must be source-available"). Injecting the text is what lets a helper
       like FeatherCamera be shared instead of copy-pasted into every project.

       Two locations because the file sits at src/Feather/Shaders in a checkout but ships beside
       buildTransitive in the package; both SDK modes must see identical source. -->
  <ItemGroup Condition="'$(FeatherInjectShaderLibrary)' == 'true' and Exists('$(FeatherShaderLibraryDirectory)')">
    <Compile Include="$(FeatherShaderLibraryDirectory)/**/*.cs"
             Visible="false"
             FeatherInjectedShaderLibrary="true" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="Compile" MetadataName="FeatherProjectRelativePath" />
    <Compile Update="@(Compile)" FeatherProjectRelativePath="%(Identity)" />
  </ItemGroup>

  <Target Name="FeatherWritePassManifest"
          AfterTargets="Build"
          Inputs="$(TargetPath);$(FeatherManifestExporterPath)"
          Outputs="$(FeatherManifestOutputs)"
          Condition="('$(FeatherEmitPassManifest)' == 'true' or '$(FeatherEmitAssetManifest)' == 'true') and Exists('$(TargetPath)')">
    <Error Condition="!Exists('$(FeatherManifestExporterPath)')"
           Text="Feather manifest exporter was not found at '$(FeatherManifestExporterPath)'." />
    <Exec Command="&quot;$(FeatherDotNetHostPath)&quot; exec &quot;$(FeatherManifestExporterPath)&quot; --assembly &quot;$(TargetPath)&quot; $(FeatherPassManifestArgument) $(FeatherAssetManifestArgument) --project-root &quot;$(MSBuildProjectDirectory)&quot; --feir-directory &quot;$(FeatherFeirDirectory)&quot;" />
  </Target>
</Project>
